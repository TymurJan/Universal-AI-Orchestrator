/* Aurora Horizon Design System */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root {
  /* Colors */
  --bg-color: #050914; /* Deep organic navy */
  --text-primary: #F8FAFC;
  --text-secondary: #94A3B8;
  --accent-emerald: #10B981;
  --talan-green: #13C45F;
  --accent-ocean: #0EA5E9;
  
  /* Step-by-Step Color Evolution Scale */
  --step-1: #10B981; /* Hero Start (Emerald)      RGB(16,  185, 129) */
  --step-2: #1EBB8D; /* NGO Hook                  RGB(30,  187, 109) — 20% */
  --step-3: #2DBE7B; /* Features                  RGB(45,  190,  90) — 40% */
  --step-4: #3BBF61; /* Pricing                   RGB(59,  191,  73) — 60% */
  --step-peak: #4ABD48; /* Mission Peak (soft Talan) RGB(74, 189,  72) — 65% */
  --step-5: #2DBE7B; /* Tech Corner (Return)      RGB(45,  190,  90) — 40% */
  --step-6: #10B981; /* Footer (Final Emerald)    RGB(16,  185, 129) */
  
  /* Glassmorphism Utilities */
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-border: rgba(255, 255, 255, 0.15);
  --glass-blur: blur(12px);
  --modal-bg: #0F172A;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 🎨 Global Premium Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.3);
}
/* Firefox Scrollbar */
* {
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background-color: transparent;
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
}

section, header, footer, .header-controls {
  position: relative;
  z-index: 2; /* Увесь контент гарантовано поверх фону */
}

/* Typography */
h1, h2, h3 {
  font-weight: 700;
  line-height: 1.2;
}

h1 {
  font-size: 3.5rem;
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
}

h2 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

/* Hybrid Glassy System */
.glass-horizontal {
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-emerald) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

/* Global Glassy Text Styles */
.text-gradient-hero {
  background: linear-gradient(135deg, var(--step-1) 0%, #059669 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

/* Step-based Glassy Text (Vertical) */
[class*="glass-step-"] {
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

/* Step-based Text Colors (Solid for clean look) */
[class*="glass-step-"] {
  display: inline-block;
}

.glass-step-1    { color: var(--el-color, var(--step-1))    !important; background: none; -webkit-text-fill-color: initial; }
.glass-step-2    { color: var(--el-color, var(--step-2))    !important; background: none; -webkit-text-fill-color: initial; }
.glass-step-3    { color: var(--el-color, var(--step-3))    !important; background: none; -webkit-text-fill-color: initial; }
.glass-step-4    { color: var(--el-color, var(--step-4))    !important; background: none; -webkit-text-fill-color: initial; }
.glass-step-peak { color: var(--el-color, var(--step-peak)) !important; background: none; -webkit-text-fill-color: initial; }
.glass-step-5    { color: var(--el-color, var(--step-5))    !important; background: none; -webkit-text-fill-color: initial; }
.glass-step-6    { color: var(--el-color, var(--step-6))    !important; background: none; -webkit-text-fill-color: initial; }


/* Glassmorphism Utilities 2.0 (Hyper-realistic) */
.glass-panel {
  background: rgba(255, 255, 255, 0.02); /* Very sheer background */
  backdrop-filter: blur(4px); /* Low blur so stars remain visible! */
  -webkit-backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-top: 1px solid rgba(255, 255, 255, 0.25); /* Edge light for glass feel */
  border-bottom: 2px solid rgba(16, 185, 129, 0.6);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  border-radius: 1.5rem;
  padding: 2rem;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  position: relative;
  overflow: hidden;
}

/* Removed ::before to keep glass completely clear */

.glass-panel:hover {
  transform: translateY(-8px);
  border-color: rgba(255, 255, 255, 0.3);
  border-bottom-color: rgba(19, 196, 95, 0.8);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 40px rgba(16, 185, 129, 0.2);
}

/* Buttons */
.btn {
  display: inline-block;
  padding: 1rem 2rem;
  border-radius: 9999px; /* Pill shape */
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
}

/* Step-based Backgrounds (Vertical) */
[class*="bg-step-"] {
  color: #fff !important;
  transition: all 0.3s ease;
}

.bg-step-1 { background: linear-gradient(to bottom, var(--step-1) 0%, #059669 100%) !important; }
.bg-step-2 { background: linear-gradient(to bottom, var(--step-2) 0%, #059669 100%) !important; }
.bg-step-3 { background: linear-gradient(to bottom, var(--step-3) 0%, #059669 100%) !important; }
.bg-step-4 { background: linear-gradient(to bottom, var(--step-4) 0%, #059669 100%) !important; }
.bg-step-peak { background: linear-gradient(to bottom, var(--step-peak) 0%, #059669 100%) !important; }
.bg-step-5 { background: linear-gradient(to bottom, var(--step-5) 0%, #059669 100%) !important; }
.bg-step-6 { background: linear-gradient(to bottom, var(--step-6) 0%, #059669 100%) !important; }


.btn-primary:active, .btn-talan:active, [class*="btn-step-"]:active {
  transform: scale(0.98);
}

.btn-primary:hover, .btn-talan:hover, [class*="btn-step-"]:hover {
  filter: brightness(1.1);
  box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
  transform: translateY(-2px);
}

.btn-step-1   { background: linear-gradient(135deg, var(--el-color, var(--step-1))   0%, #059669 100%) !important; color: #fff !important; }
.btn-step-2   { background: linear-gradient(135deg, var(--el-color, var(--step-2))   0%, #059669 100%) !important; color: #fff !important; }
.btn-step-3   { background: linear-gradient(135deg, var(--el-color, var(--step-3))   0%, #059669 100%) !important; color: #fff !important; }
.btn-step-4   { background: linear-gradient(135deg, var(--el-color, var(--step-4))   0%, #059669 100%) !important; color: #fff !important; }
.btn-step-peak{ background: linear-gradient(135deg, var(--el-color, var(--step-peak)) 0%, #059669 100%) !important; color: #fff !important; }
.btn-step-5   { background: linear-gradient(135deg, var(--el-color, var(--step-5))   0%, #059669 100%) !important; color: #fff !important; }
.btn-step-6   { background: linear-gradient(135deg, var(--el-color, var(--step-6))   0%, #059669 100%) !important; color: #fff !important; }



.btn-glass {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
}

.btn-glass:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

/* Hero Section & Backgrounds */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 5%;
  text-align: center;
  z-index: 1;
}

/* Background Enhancements: Stars and Aurora Mesh */

#space-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  background-color: #050914; /* Deep, clean space base */
  overflow: hidden;
  pointer-events: none;
}

#space-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.aurora-ribbon {
  position: absolute;
  filter: blur(100px);
  opacity: 0.7;
  border-radius: 50%;
  transform-origin: center center;
  z-index: 1; /* Зірки мають бути поверх (z-index: 2) */
  mix-blend-mode: screen;
}

.ribbon-1 {
  width: 140vw;
  height: 60vh;
  background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.7) 0%, rgba(19, 196, 95, 0) 60%);
  top: -15vh;
  left: -20vw;
  animation: aurora-1 25s ease-in-out infinite alternate;
}

.ribbon-2 {
  width: 160vw;
  height: 70vh;
  background: radial-gradient(ellipse at center, rgba(14, 165, 233, 0.4) 0%, rgba(14, 165, 233, 0) 65%);
  bottom: -20vh;
  right: -30vw;
  animation: aurora-2 32s ease-in-out infinite alternate-reverse;
}

.ribbon-3 {
  width: 120vw;
  height: 40vh;
  background: radial-gradient(ellipse at center, rgba(19, 196, 95, 0.6) 0%, rgba(19, 196, 95, 0) 70%);
  top: 40vh;
  left: 10vw;
  animation: aurora-3 20s ease-in-out infinite alternate;
}

@keyframes aurora-1 {
  0% { transform: rotate(-15deg) scale(1) translateY(0); opacity: 0.6; }
  100% { transform: rotate(-10deg) scale(1.1) translateY(-5vh); opacity: 0.8; }
}

@keyframes aurora-2 {
  0% { transform: rotate(15deg) scale(1) translateX(0); opacity: 0.5; }
  100% { transform: rotate(20deg) scale(1.1) translateX(-5vw); opacity: 0.7; }
}

@keyframes aurora-3 {
  0% { transform: rotate(-25deg) scale(1) translateY(0); opacity: 0.6; }
  100% { transform: rotate(-30deg) scale(1.2) translateY(5vh); opacity: 0.9; }
}



/* 3D Cube Visual Styles */
.hero-cube-visual {
  position: absolute;
  right: 10%;
  top: 50%;
  transform: translateY(-50%);
  width: 300px;
  height: 300px;
  perspective: 1000px;
  z-index: 3;
}

.cube-container {
  width: 200px;
  height: 200px;
  position: relative;
  transform-style: preserve-3d;
  /* animation: cubeRotation 20s linear infinite; */
}

.cube {
  width: 100%;
  height: 100%;
  position: absolute;
  transform-style: preserve-3d;
}

.cube-face {
  position: absolute;
  width: 200px;
  height: 200px;
  border: 2px solid rgba(16, 185, 129, 0.4);
  background: rgba(6, 18, 14, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 30px rgba(16, 185, 129, 0.2);
  backdrop-filter: blur(5px);
}

.face-front  { transform: rotateY(0deg) translateZ(100px); }
.face-back   { transform: rotateY(180deg) translateZ(100px); }
.face-right  { transform: rotateY(90deg) translateZ(100px); }
.face-left   { transform: rotateY(-90deg) translateZ(100px); }
.face-top    { transform: rotateX(90deg) translateZ(100px); }
.face-bottom { transform: rotateX(-90deg) translateZ(100px); }

@keyframes cubeRotation {
  0% { transform: rotateX(0deg) rotateY(0deg); }
  100% { transform: rotateX(360deg) rotateY(360deg); }
}


  50% { transform: scale(1.05) translate(-1%, -1%); }
  100% { transform: scale(1) translate(0, 0); }
}

/* WEBM Video Background Container */
.webm-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -1;
  opacity: 0; /* Hidden by default, toggled via JS */
  transition: opacity 1s ease;
  mix-blend-mode: screen;
}

.webm-bg.active {
  opacity: 0.8;
}

.aurora-bg.hidden {
  opacity: 0;
}

.view-toggle {
  display: none; /* Замінено на .header-controls */
}

.header-controls {
  position: fixed;
  top: 1rem;
  right: 1.5rem;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  align-items: flex-end;
}

.dropdown-control {
  position: relative;
  width: 65px;
  transition: width 0.3s ease;
}

.dropdown-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  border-radius: 2rem;
  padding: 0.4rem 0.75rem;
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
}

.dropdown-trigger:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.2);
}

.chevron-icon {
  transition: transform 0.3s ease;
  opacity: 0.6;
}

.dropdown-control.active .chevron-icon {
  transform: rotate(180deg);
}

.dropdown-options {
  position: absolute;
  top: calc(100% + 0.5rem);
  right: 0;
  background: var(--modal-bg);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  border-radius: 1rem;
  padding: 0.4rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  min-width: 100px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

.dropdown-control.active {
  z-index: 10;
}

.dropdown-control.active .dropdown-options {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.lang-btn, .curr-btn {
  background: none;
  border: none;
  color: var(--text-secondary);
  padding: 0.5rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
  text-align: left;
  white-space: nowrap;
}

.lang-btn:hover, .curr-btn:hover {
  background: rgba(255,255,255,0.05);
  color: #fff;
}

.lang-btn.active, .curr-btn.active {
  background: var(--step-1);
  color: #fff;
}

.toggle-group.compact {
  border-radius: 2rem;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
}

.switch.small {
  width: 40px;
  height: 20px;
}

.switch.small .slider:before {
  height: 14px;
  width: 14px;
  left: 3px;
  bottom: 2px;
}

.switch.small input:checked + .slider:before {
  transform: translateX(20px);
}

/* Copy Buttons */
.copy-btn {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  color: var(--text-secondary);
  padding: 0.5rem;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-btn:hover {
  background: rgba(255,255,255,0.1);
  color: #fff;
}

.copy-btn.btn-success {
  background: linear-gradient(135deg, var(--accent-emerald) 0%, #059669 100%) !important;
  color: #fff !important;
  border-color: transparent !important;
}

.copy-icon {
  stroke: currentColor;
}

/* Sections */
section {
  padding: 1.5rem 5%;
  position: relative;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

/* NGO Hook Banner */
.ngo-hook {
  background: rgba(6, 78, 59, 0.4);
  backdrop-filter: blur(5px);
  border-top: 1px solid rgba(16, 185, 129, 0.2);
  border-bottom: 1px solid rgba(16, 185, 129, 0.2);
  text-align: center;
  padding: 4rem 5%;
  margin: 4rem 0;
}

.ngo-hook p {
  font-size: 1.25rem;
  color: var(--text-primary);
  max-width: 800px;
  margin: 0 auto;
}

/* Features Grid */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.feature-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 1.5rem;
}

.feature-text {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff !important;
}

.feature-icon svg {
  width: 80px;
  height: 80px;
  stroke: rgba(255, 255, 255, 0.95);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
  filter: drop-shadow(0 0 8px currentColor);
}

.feature-icon-img {
  width: 90px;
  height: 90px;
  object-fit: contain;
  filter: drop-shadow(0 0 10px rgba(16, 185, 129, 0.5));
  display: block;
}

.feature-desc {
  color: var(--text-secondary);
  font-size: 0.95rem;
  /* Clean design focus: initially dim, lights up on hover */
  opacity: 0.8;
  transition: opacity 0.3s;
}

.feature-card:hover .feature-desc {
  opacity: 1;
}

/* NGO Mission Section */
.mission-section {
  background: radial-gradient(circle at center, rgba(19, 196, 95, 0.15) 0%, transparent 80%);
  border: 1px solid rgba(19, 196, 95, 0.3);
  box-shadow: 0 0 40px rgba(19, 196, 95, 0.1);
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 3rem;
  align-items: center;
}

.mission-visual {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

.mission-visual img {
  width: 100%;
  height: auto;
  border-radius: 2rem;
  border-color: rgba(19, 196, 95, 0.4);
}

.mission-image {
  width: 100%;
  border-radius: 1.5rem;
  border: 1px solid rgba(255,255,255,0.1);
  opacity: 0.7;
}

/* Tech Corner */
.tech-corner {
  background: #020617; /* Very dark slate */
  color: var(--text-secondary);
  border-top: 1px solid #1E293B;
}

.tech-corner h2, .tech-corner h4 {
  font-family: 'Inter', sans-serif;
  color: #fff;
}

.tech-corner p {
  font-family: 'Inter', sans-serif;
}

.code-block {
  background: #0F172A;
  padding: 2rem;
  border-radius: 1rem;
  border: 1px solid #1E293B;
  overflow-x: auto;
}

.code-block pre {
  font-family: 'Courier New', Courier, monospace;
  color: #38BDF8;
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — TABLET (769px – 992px)
═══════════════════════════════════════════════ */
@media (max-width: 992px) {
  .container { padding: 0 1.5rem; }

  /* Hero */
  .hero-content {
    display: flex !important;
    flex-direction: column !important;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .hero-visual-side { display: flex; order: -1; margin-bottom: 1.5rem; }
  .premium-cube-img { max-width: 280px; }
  .hero-text-side { align-items: center; }
  .hero-title { font-size: 2.4rem; }
  .hero-cta { justify-content: center; flex-wrap: wrap; }

  /* Feature cards */
  .features-grid { grid-template-columns: repeat(2, 1fr); }

  /* Pricing */
  .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  .price-card.popular { transform: scale(1); }

  /* Mission */
  .mission-section { grid-template-columns: 1fr; gap: 2rem; }
  .mission-visual { display: none; }

  /* Header controls */
  .header-controls { top: 0.75rem; right: 0.75rem; }
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — MOBILE (≤768px)
═══════════════════════════════════════════════ */
@media (max-width: 768px) {
  /* Typography */
  h1, .hero-title { font-size: 1.9rem !important; line-height: 1.25; }
  h2 { font-size: 1.5rem !important; }
  h3 { font-size: 1.2rem !important; }

  /* Container */
  .container { padding: 0 1rem; max-width: 100%; }
  section { padding: 3rem 0; }

  /* Header controls — always visible, top-right */
  .header-controls {
    top: 0.5rem;
    right: 0.5rem;
    gap: 0.4rem;
  }
  .dropdown-trigger { font-size: 0.75rem; padding: 0.3rem 0.5rem; }

  /* Hero */
  .hero { padding: 4rem 0 2rem; }
  .hero-content {
    display: flex !important;
    flex-direction: column !important;
    padding: 1.5rem 1rem;
    gap: 1.5rem;
    text-align: center;
  }
  .hero-visual-side { display: flex; order: -1; margin-bottom: 0.5rem; }
  .premium-cube-img { max-width: 240px; }
  .hero-text-side { align-items: center; }
  .hero-title { text-align: center; }
  .hero-description { text-align: center; font-size: 0.95rem; }
  .hero-cta { justify-content: center; flex-wrap: wrap; gap: 0.75rem; }
  .hero-cta .btn { width: 100%; max-width: 280px; text-align: center; }

  /* NGO hook / feature badges */
  .ngo-hook { padding: 1.5rem 1rem; }
  .ngo-hook .container > div { flex-direction: column; align-items: center; text-align: center; gap: 1rem; }

  /* Feature cards — single column */
  .features-grid {
    grid-template-columns: 1fr !important;
    gap: 1rem;
  }
  .feature-card { padding: 1.25rem; }

  /* Pricing — single column */
  .pricing-grid {
    grid-template-columns: 1fr !important;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .price-card.popular { transform: scale(1); }
  .pricing-section { padding: 1.5rem 1rem; }

  /* Mission */
  .mission-section {
    grid-template-columns: 1fr !important;
    gap: 1.5rem;
  }
  .mission-visual { display: none; }
  .glass-panel.mission-section { padding: 1.5rem 1rem; }

  /* Charity row */
  .mission-section > div:last-child { padding: 1rem 0; }

  /* Tech corner / footer */
  .tech-corner .container > div[style*="flex"] {
    flex-direction: column !important;
    gap: 2rem !important;
    text-align: center;
  }

  /* Code block */
  .code-block { font-size: 0.8rem; overflow-x: auto; }

  /* Buttons */
  .btn { font-size: 0.9rem; padding: 0.7rem 1.2rem; }
  .btn-step-peak, .btn-step-4 { width: 100%; max-width: 300px; }
}

/* Pricing & Benefactors Styles */
.pricing-section {
  padding: 1.5rem 5%;
}

.hero .container {
  max-width: 1200px !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
}

/* Hero Visual — Left-side neural ECG image */
.hero-visual {
  flex: 0 0 auto;
  width: 380px;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border-radius: 1.5rem;
}

.hero-banner-img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 1rem;
  /* Smooth edge blend into the dark background */
  -webkit-mask-image: radial-gradient(ellipse 92% 88% at center, #000 50%, transparent 100%);
  mask-image: radial-gradient(ellipse 92% 88% at center, #000 50%, transparent 100%);
  filter: drop-shadow(0 0 35px rgba(16, 185, 129, 0.3));
}

.hero-banner-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70%;
  height: 70%;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, transparent 70%);
  filter: blur(50px);
  z-index: -1;
}

@keyframes bannerFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.hero-content {
  display: grid;
  grid-template-columns: 450px 1fr;
  grid-template-rows: auto auto auto auto;
  gap: 0 4rem;
  align-items: center;
  text-align: left;
  padding: 4rem 3rem;
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  border-radius: 2rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-top: 1px solid rgba(255, 255, 255, 0.25);
  border-bottom: 2px solid rgba(16, 185, 129, 0.6);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  position: relative;
  z-index: 5;
  overflow: visible;
}

.hero-visual-side {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.premium-cube-img {
  width: 100%;
  max-width: 450px;
  border-radius: 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 10px 40px rgba(16, 185, 129, 0.2);
  display: block;
  z-index: 2;
  position: relative;
}

.hero-text-side {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  z-index: 2;
}

.hero-image-column {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-brain-img {
  width: 100%;
  max-width: 500px;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 10px 40px rgba(16, 185, 129, 0.15);
  display: block;
}

.hero-text-column {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  text-align: left;
}

.hero-text-side p {
  font-size: 1.05rem;
  line-height: 1.5;
  color: var(--text-secondary);
}

.hero-title {
  text-align: left;
  z-index: 2;
}

.hero-title h1 {
  font-size: 2.25rem;
  line-height: 1.2;
  margin-bottom: 0;
}

.hero-description-text {
  font-size: 1.15rem;
  color: var(--text-secondary);
  line-height: 1.6;
  max-width: 100%;
  margin: 0;
}

.hero-description p {
  font-size: 1.15rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  line-height: 1.7;
}

.hero-cta {
  display: flex;
  justify-content: flex-start;
  gap: 1rem;
  z-index: 2;
}

.hero-graphic {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400px;
  position: relative;
}

.hero-asset-container {
  position: relative;
  width: 100%;
  max-width: 330px;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: heroFloat 6s ease-in-out infinite;
}

.hero-image-asset {
  width: 100%;
  height: auto;
  filter: drop-shadow(0 0 30px rgba(16, 185, 129, 0.35));
  z-index: 2;
  border-radius: 1rem;
}

.cinematic-icon {
  width: 80px;
  height: 80px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 2rem;
}

.feature-image-asset {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: brightness(1.2) drop-shadow(0 0 15px rgba(16, 185, 129, 0.5));
  mix-blend-mode: screen;
}

.hero-glow-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 80%;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
  filter: blur(40px);
  z-index: 1;
  animation: heroGlowPulse 4s ease-in-out infinite alternate;
}

@keyframes heroFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20px); }
}

@keyframes heroGlowPulse {
  0% { opacity: 0.5; transform: translate(-50%, -50%) scale(0.9); }
  100% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
}

@media (max-width: 992px) {
  .hero-content {
    padding: 2.5rem 1.5rem;
  }
  .hero-title, .hero-description {
    max-width: 100%;
    text-align: center;
  }
  .hero-top-row {
    flex-direction: column;
    text-align: center;
  }
  .hero-title {
    text-align: center;
  }
  .hero-description {
    text-align: center;
  }
  .hero-cta {
    justify-content: center;
  }
  .hero-visual {
    width: 320px;
  }
}


.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2.5rem;
  margin-top: 4rem;
}

.price-card {
  position: relative;
  overflow: hidden;
  text-align: center;
}

.price-card.popular {
  border-color: var(--accent-emerald);
  box-shadow: 0 0 30px rgba(16, 185, 129, 0.15);
  transform: scale(1.05);
}

.price-card .badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  /* background handled by bg-step-* class */
  color: #fff;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
}

.price-features li::before {
  content: "✦";
  color: var(--step-4);
  font-weight: bold;
}

.price-header {
  margin-bottom: 2rem;
}

.annual-price {
  font-size: 1.6rem;
  font-weight: 700;
  display: block;
  margin-bottom: 0.2rem;
  transition: transform 0.3s ease;
}

.price-card:hover .annual-price {
  transform: scale(1.05);
}

.setup-price {
  font-size: 0.8rem;
  color: var(--text-secondary);
  display: block;
}

.price-features {
  list-style: none;
  margin-bottom: 2.5rem;
  text-align: left;
}

.price-features li {
  margin-bottom: 0.75rem;
  color: var(--text-secondary);
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}



/* Benefactor Section */
.benefactor-section {
  margin-top: 2rem;
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
  border: 1px solid rgba(236, 72, 153, 0.1);
  padding: 4rem;
  border-radius: 2rem;
  text-align: center;
}

.iban-card {
  margin-top: 2rem;
  background: rgba(255,255,255,0.03);
  padding: 2rem;
  border-radius: 1.5rem;
  border: 1px dashed rgba(255,255,255,0.1);
}

.iban-number {
  font-family: 'Courier New', monospace;
  font-size: 1.25rem;
  color: #fff;
  letter-spacing: 0.1em;
  display: block;
  margin: 1rem 0;
  word-break: break-all;
}

/* Modal Styles */
.modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.modal.active {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: var(--modal-bg);
  border: 1px solid var(--glass-border);
  padding: 3rem;
  border-radius: 2rem;
  max-width: 600px;
  width: 90%;
  position: relative;
  box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  max-height: 90vh;
  overflow-y: auto;
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

/* Completely hide scrollbar for modal content specifically */
.modal-content::-webkit-scrollbar {
  width: 0px !important;
  display: none !important;
}
.modal-content {
  -ms-overflow-style: none !important;
  scrollbar-width: none !important;
}

.close-modal {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  font-size: 1.5rem;
  color: var(--text-secondary);
  cursor: pointer;
  background: none;
  border: none;
}

/* Modal Accordion Details */
.modal-subtext {
  font-size: 1rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

.modal-feature-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.modal-feature-list details {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 0.75rem;
  overflow: hidden;
  transition: background 0.3s ease;
}

.modal-feature-list details[open] {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.15);
}

.modal-feature-list summary {
  padding: 1rem 1.25rem;
  cursor: pointer;
  font-weight: 600;
  color: #fff;
  display: block; /* Removing flex so custom arrow floats right cleanly */
  list-style: none;
  position: relative;
  padding-right: 2.5rem; /* Space for the arrow */
}

.modal-feature-list summary::-webkit-details-marker {
  display: none;
}

.modal-feature-list summary::after {
  content: "▼";
  position: absolute;
  right: 1.25rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: 0.8rem;
  color: var(--text-secondary);
  transition: transform 0.3s ease;
}

.modal-feature-list details[open] summary::after {
  transform: translateY(-50%) rotate(180deg);
  color: var(--step-4);
}

.details-content {
  padding: 0 1.25rem 1.25rem 1.25rem;
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.6;
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  margin-top: 0.5rem;
  padding-top: 1rem;
}

.stars-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%201000%201000%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%0A%20%20%20%20%20%20%20%20%3Cdefs%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cfilter%20id%3D%27nebulaFilter%27%20x%3D%27-80%25%27%20y%3D%27-80%25%27%20width%3D%27260%25%27%20height%3D%27260%25%27%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.008%200.03%27%20numOctaves%3D%273%27%20seed%3D%27830%27%20result%3D%27velvetNoise%27/%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.04%200.09%27%20numOctaves%3D%275%27%20seed%3D%27441%27%20result%3D%27detailNoise%27/%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%21--%20Increased%20blur%20for%20softer%20edges%20--%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeGaussianBlur%20stdDeviation%3D%2725%27%20in%3D%27SourceGraphic%27%20result%3D%27blurBase%27/%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeDisplacementMap%20in%3D%27blurBase%27%20in2%3D%27velvetNoise%27%20scale%3D%2790%27%20xChannelSelector%3D%27R%27%20yChannelSelector%3D%27G%27%20result%3D%27displacedMist%27/%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeComposite%20operator%3D%27in%27%20in%3D%27detailNoise%27%20in2%3D%27displacedMist%27%20result%3D%27maskedMist%27/%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%271%200%200%200%200%20%200%201%200%200%200%20%200%200%201%200%200%20%200%200%200%201.5%20-0.4%27%20/%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C/filter%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cfilter%20id%3D%27starBloom%27%20x%3D%27-100%25%27%20y%3D%27-100%25%27%20width%3D%27300%25%27%20height%3D%27300%25%27%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CfeGaussianBlur%20stdDeviati