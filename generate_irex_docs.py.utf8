    run_sig_head = p_sig_head.add_run("ÐÑÐ´Ð¿Ð¸ÑÐ¸ ÑÑÐ¾ÑÑÐ½:")
    run_sig_head.font.bold = False
    
    table = doc.add_table(rows=2, cols=2)
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
