            p.text = "ÐÑÐ´Ð¿Ð¾Ð²ÑÐ´Ð°Ð»ÑÐ½Ð° Ð¾ÑÐ¾Ð±Ð° Ð·Ð° Ð·Ð±ÑÑ, Ð°Ð½Ð°Ð»ÑÐ· Ñ Ð·Ð²ÑÑÐ½ÑÑÑÑ Ð´Ð°Ð½Ð¸Ñ: Ð¨Ð°Ð¿Ð¾Ð²Ð°Ð» Ð¢Ð¸Ð¼ÑÑ Ð®ÑÑÐ¹Ð¾Ð²Ð¸Ñ, ÐÐ¾Ð»Ð¾Ð²Ð° Ð¿ÑÐ°Ð²Ð»ÑÐ½Ð½Ñ ÐÐ Â«Ð¢ÐÐÐÐ Ð®ÐÂ»"
        elif "Signature of the Head of organization" in p.text:
            p.text = "Signature of the Head of organization: / Ð¢Ð¸Ð¼ÑÑ Ð¨ÐÐÐÐÐÐ / ___________________    ÐÐ°ÑÐ° â___â ___________ 2026 Ñ."
            
    doc.save(OUT_DIR / f"01_IREX_Grant_Proposal_NovyShlyakh_FULL_{DOC_VERSION}.docx")
    print(f"â Main proposal generated ({DOC_VERSION} - Donor Template Filled).")

# ==========================================
# 2. GENERATE LETTERS OF SUPPORT
# ==========================================
def generate_support_letter(filename, partner_name, partner_title, partner_org, specific_text):
    doc = create_dstu_document()
    
    p_head = doc.add_paragraph()
    p_head.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    run_head = p_head.add_run("ÐÑÐ¶Ð½Ð°ÑÐ¾Ð´Ð½ÑÐ¹ ÑÐ°Ð´Ñ Ð½Ð°ÑÐºÐ¾Ð²Ð¸Ñ Ð´Ð¾ÑÐ»ÑÐ´Ð¶ÐµÐ½Ñ ÑÐ° Ð¾Ð±Ð¼ÑÐ½ÑÐ² (IREX)\nÐÐ¾Ð½ÐºÑÑÑÐ½Ð° ÐºÐ¾Ð¼ÑÑÑÑ Ð¿ÑÐ¾Ð³ÑÐ°Ð¼Ð¸ Ð¿ÑÐ´ÑÑÐ¸Ð¼ÐºÐ¸ Ð²ÐµÑÐµÑÐ°Ð½ÑÐ²\n\n")
    run_head.font.bold = True
    
    p_from = doc.add_paragraph()
    p_from.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    p_from.add_run(f"Ð²ÑÐ´: {partner_org}\nÐÐ´ÑÐµÑÐ°: Ð¼. Ð§ÐµÑÐºÐ°ÑÐ¸\n").font.italic = True
    
    doc.add_paragraph().paragraph_format.space_after = Pt(24)
    
    p_title = doc.add_paragraph()
    p_title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run_title = p_title.add_run("ÐÐÐ¡Ð¢ ÐÐÐÐ¢Ð ÐÐÐÐ ÐÐ ÐÐÐÐ¢Ð£ Â«ÐÐÐÐÐ Ð¨ÐÐ¯Ð¥Â»")
    run_title.font.size = Pt(14)
    run_title.font.bold = True
    p_title.paragraph_format.space_after = Pt(18)
    
    doc.add_paragraph(f"{partner_org} Ð·Ð°ÑÐ²ÑÐ´ÑÑÑ ÑÐ²Ð¾Ñ Ð¿Ð¾Ð²Ð°Ð³Ñ ÐÑÐ¶Ð½Ð°ÑÐ¾Ð´Ð½ÑÐ¹ ÑÐ°Ð´Ñ Ð½Ð°ÑÐºÐ¾Ð²Ð¸Ñ Ð´Ð¾ÑÐ»ÑÐ´Ð¶ÐµÐ½Ñ ÑÐ° Ð¾Ð±Ð¼ÑÐ½ÑÐ² (IREX) ÑÐ° ÑÐ¸Ð¼ Ð»Ð¸ÑÑÐ¾Ð¼ Ð²Ð¸ÑÐ»Ð¾Ð²Ð»ÑÑ ÑÑÐ»ÐºÐ¾Ð²Ð¸ÑÑ Ð¿ÑÐ´ÑÑÐ¸Ð¼ÐºÑ Ð¿ÑÐ¾ÑÐºÑÐ½ÑÐ¹ Ð·Ð°ÑÐ²ÑÑ ÐÑÐ¾Ð¼Ð°Ð´ÑÑÐºÐ¾Ñ Ð¾ÑÐ³Ð°Ð½ÑÐ·Ð°ÑÑÑ Â«Ð¢ÐÐÐÐ Ð®ÐÂ» (ÐÐÐ ÐÐÐ£: 45119390) Ð¿ÑÐ´ Ð½Ð°Ð·Ð²Ð¾Ñ Â«ÐÐ¾Ð²Ð¸Ð¹ Ð¨Ð»ÑÑ: Ð¦Ð¸ÑÑÐ¾Ð²Ð° Ð´Ð¸ÑÐ¿ÐµÑÑÐµÑÑÑÐºÐ° ÑÐ° ÑÐµÐ³ÑÐ¾Ð½Ð°Ð»ÑÐ½Ð¸Ð¹ ÐºÐ¾Ð¾ÑÐ´Ð¸Ð½Ð°ÑÑÐ¹Ð½Ð¸Ð¹ ÑÐ°Ð± Ð¿ÑÐ´ÑÑÐ¸Ð¼ÐºÐ¸ Ð²ÐµÑÐµÑÐ°Ð½ÑÐ² Ð§ÐµÑÐºÐ°ÑÐ¸Ð½Ð¸Â».")
    
    doc.add_paragraph(specific_text)
    
    doc.add_paragraph("ÐÐ¸ Ð¿ÐµÑÐµÐºÐ¾Ð½Ð°Ð½Ñ, ÑÐ¾ ÑÑÐ²Ð¾ÑÐµÐ½Ð½Ñ Ð³ÑÐ±ÑÐ¸Ð´Ð½Ð¾Ñ Â«Ð¦Ð¸ÑÑÐ¾Ð²Ð¾Ñ Ð´Ð¸ÑÐ¿ÐµÑÑÐµÑÑÑÐºÐ¾ÑÂ» Ñ Ð½Ð°Ð³Ð°Ð»ÑÐ½Ð¾Ñ ÑÐ° ÐºÑÐ¸ÑÐ¸ÑÐ½Ð¾ Ð²Ð°Ð¶Ð»Ð¸Ð²Ð¾Ñ ÑÐ½ÑÑÑÐ°ÑÐ¸Ð²Ð¾Ñ Ð´Ð»Ñ Ð§ÐµÑÐºÐ°ÑÑÐºÐ¾Ñ Ð¾Ð±Ð»Ð°ÑÑÑ. ÐÐ»Ð°ÑÑÐ¾ÑÐ¼Ð° Â«ÐÐ¾Ð²Ð¸Ð¹ Ð¨Ð»ÑÑÂ» Ð´Ð¾Ð·Ð²Ð¾Ð»Ð¸ÑÑ Ð¾Ð±'ÑÐ´Ð½Ð°ÑÐ¸ Ð·ÑÑÐ¸Ð»Ð»Ñ Ð´ÐµÑÐ¶Ð°Ð²Ð½Ð¾Ð³Ð¾, Ð³ÑÐ¾Ð¼Ð°Ð´ÑÑÐºÐ¾Ð³Ð¾ ÑÐ° Ð¿ÑÐ¸Ð²Ð°ÑÐ½Ð¾Ð³Ð¾ ÑÐµÐºÑÐ¾ÑÑÐ², ÑÑÑÐ½ÑÑÐ¸ Ð±ÑÑÐ¾ÐºÑÐ°ÑÐ¸ÑÐ½Ñ Ð±Ð°Ñ'ÑÑÐ¸ ÑÐ° Ð·Ð°Ð±ÐµÐ·Ð¿ÐµÑÐ¸ÑÐ¸ Ð²ÐµÑÐµÑÐ°Ð½Ð°Ð¼ ÑÐ²Ð¸Ð´ÐºÐ¸Ð¹ Ñ Ð¿ÑÐ¾Ð·Ð¾ÑÐ¸Ð¹ Ð´Ð¾ÑÑÑÐ¿ Ð´Ð¾ Ð²ÐµÑÐ¸ÑÑÐºÐ¾Ð²Ð°Ð½Ð¸Ñ ÑÐ°ÑÑÐ²ÑÑÐ².")
    
    doc.add_paragraph(f"ÐÑ ÑÐ²Ð¾Ð³Ð¾ Ð±Ð¾ÐºÑ, {partner_org} Ð¿ÑÐ´ÑÐ²ÐµÑÐ´Ð¶ÑÑ Ð³Ð¾ÑÐ¾Ð²Ð½ÑÑÑÑ Ð´Ð¾ Ð°ÐºÑÐ¸Ð²Ð½Ð¾Ñ ÑÐ¿ÑÐ²Ð¿ÑÐ°ÑÑ Ð· ÐÐ Â«Ð¢Ð°Ð»Ð°Ð½ Ð®ÐÂ», ÑÑÐ°ÑÑÑ Ð² ÑÐ¾Ð±Ð¾ÑÑ ÑÐµÐ³ÑÐ¾Ð½Ð°Ð»ÑÐ½Ð¾Ñ ÐºÐ¾Ð¾ÑÐ´Ð¸Ð½Ð°ÑÑÐ¹Ð½Ð¾Ñ ÑÐ°Ð´Ð¸, ÑÐ¿ÑÐ»ÑÐ½Ð¾Ð³Ð¾ Ð¿ÑÐ¾Ð²ÐµÐ´ÐµÐ½Ð½Ñ ÑÐ½ÑÐ¾ÑÐ¼Ð°ÑÑÐ¹Ð½Ð¸Ñ Ð·Ð°ÑÐ¾Ð´ÑÐ² ÑÐ° Ð¿ÑÐ´Ð¿Ð¸ÑÐ°Ð½Ð½Ñ Ð²ÑÐ´Ð¿Ð¾Ð²ÑÐ´Ð½Ð¾Ð³Ð¾ ÐÐµÐ¼Ð¾ÑÐ°Ð½Ð´ÑÐ¼Ñ Ð¿ÑÐ¾ ÑÐ¿ÑÐ²Ð¿ÑÐ°ÑÑ (MoU) Ð¿ÑÑÐ»Ñ Ð¿Ð¾ÑÐ°ÑÐºÑ ÑÐµÐ°Ð»ÑÐ·Ð°ÑÑÑ Ð¿ÑÐ¾ÑÐºÑÑ.")
    
    p_last = add_paragraph_with_keep(doc, "ÐÑÐ¾ÑÐ¸Ð¼Ð¾ ÐºÐ¾Ð½ÐºÑÑÑÐ½Ñ ÐºÐ¾Ð¼ÑÑÑÑ IREX Ð¿ÑÐ´ÑÑÐ¸Ð¼Ð°ÑÐ¸ ÑÑ ÑÐ½ÑÑÑÐ°ÑÐ¸Ð²Ñ, ÑÐºÐ° Ð¼Ð°Ñ ÑÑÑÐ°ÑÐµÐ³ÑÑÐ½Ðµ Ð·Ð½Ð°ÑÐµÐ½Ð½Ñ Ð´Ð»Ñ ÑÑÐ¿ÑÑÐ½Ð¾Ñ ÑÐµÑÐ½ÑÐµÐ³ÑÐ°ÑÑÑ Ð²ÐµÑÐµÑÐ°Ð½ÑÐ² ÑÐ° ÑÐ»ÐµÐ½ÑÐ² ÑÑÐ½ÑÑ ÑÐ¾Ð´Ð¸Ð½ Ñ Ð½Ð°ÑÑÐ¹ Ð³ÑÐ¾Ð¼Ð°Ð´Ñ.", is_last_before_signature=True)
    
    add_single_signature_block(doc, partner_org, partner_title, partner_name)
    
    doc.save(OUT_DIR / filename)
    print(f"â Support letter generated: {filename}")

